<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="nimitaco" value="https://nuget.pkg.github.com/NimitaCo/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Credenciales del feed privado por variable de entorno: nunca en el repo.
       Local: PAT clasico con `read:packages`. CI: secreto NIMITACO_NUGET_TOKEN. -->
  <packageSourceCredentials>
    <nimitaco>
      <add key="Username" value="%NIMITACO_NUGET_USER%" />
      <add key="ClearTextPassword" value="%NIMITACO_NUGET_TOKEN%" />
    </nimitaco>
  </packageSourceCredentials>

  <!-- Solo se consulta el feed privado para `Es.Nimita.*`. Asi un repo que aun no
       consume esos paquetes restaura sin credenciales, y ningun paquete publico
       puede suplantarse desde el feed privado (dependency confusion). -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="nimitaco">
      <package pattern="Es.Nimita.*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
