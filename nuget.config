<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="nimitaco" value="https://nuget.pkg.github.com/NimitaCo/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Sin credenciales en el repo: NuGet las lee de la variable de entorno
         NuGetPackageSourceCredentials_nimitaco
       con el formato `Username=<usuario>;Password=<PAT con read:packages>`.
       Si la variable no existe el feed queda anonimo, que es un estado valido:
       no se consulta mientras no se referencie un paquete Es.Nimita.*.
       Ojo: NO declarar <packageSourceCredentials> aqui con valores por variable
       de entorno; si la variable existe pero esta vacia, NuGet aborta el restore
       con "Value cannot be null or empty string (Parameter 'password')". -->

  <!-- El feed privado solo se consulta para `Es.Nimita.*`: asi un repo que aun no
       consume esos paquetes restaura sin credenciales, y ningun paquete publico
       puede suplantarse desde el feed privado (dependency confusion). -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="nimitaco">
      <package pattern="Es.Nimita.*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
