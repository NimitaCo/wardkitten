@page "/watches/new"
@page "/watches/{Id}/edit"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject WardkittenApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@(IsEdit ? "Editar" : "Nueva") vigilancia · Wardkitten</PageTitle>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <h1 class="h3 mb-3">@(IsEdit ? "Editar vigilancia" : "Nueva vigilancia")</h1>

        <div class="mb-3">
            <label class="form-label">Nombre</label>
            <input class="form-control" @bind="_name" placeholder="Regar las plantas" />
        </div>
        <div class="mb-3">
            <label class="form-label">Descripción</label>
            <input class="form-control" @bind="_description" />
        </div>

        <div class="mb-3">
            <label class="form-label">Tipo</label>
            <select class="form-select" @bind="_type" @bind:after="OnTypeChangedAsync">
                <option value="@WatchType.Manual">Manual (confirmo yo)</option>
                <option value="@WatchType.Ping">Ping (un proceso avisa por URL)</option>
            </select>
        </div>

        @if (_type == WatchType.Ping)
        {
            <div class="card border-primary-subtle mb-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                        <div>
                            <h2 class="h6 mb-0">🧪 Comprobar que llegan las solicitudes</h2>
                            <small class="text-muted">Llama a esta URL desde tu sistema y verás aquí cada solicitud.</small>
                        </div>
                        @if (_test is not null)
                        {
                            <div class="d-flex gap-2">
                                @if (_test.Mode == PingProbeMode.DryRun && _test.TestModeUntilUtc is null)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="StartTestAsync" disabled="@_testBusy">Reanudar prueba</button>
                                }
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="StopTestAsync" disabled="@_testBusy">Terminar prueba</button>
                            </div>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="StartTestAsync" disabled="@_testBusy">
                                @(HasSavedUrl ? "Probar sin que cuente" : "Obtener URL de prueba")
                            </button>
                        }
                    </div>

                    @if (PingUrl is { Length: > 0 } url)
                    {
                        <div class="input-group input-group-sm mb-1">
                            <input class="form-control font-monospace" readonly value="@url" />
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => CopyAsync(url)">@(_copied ? "¡Copiada!" : "Copiar")</button>
                        </div>
                        <p class="small text-muted mb-2">
                            <code>curl -fsS @url</code> · variantes <code>/start</code> y <code>/fail</code>.
                        </p>
                    }

                    @if (_test?.Mode == PingProbeMode.DryRun)
                    {
                        @if (_test.TestModeUntilUtc is DateTime until)
                        {
                            <div class="alert alert-warning py-2 small mb-2">
                                <strong>Prueba en curso hasta las @Hora(until).</strong> Las solicitudes a esta URL no
                                reinician los contadores y, mientras dure, esta vigilancia no se evalúa ni avisa.
                                Al guardar o al terminar la prueba vuelve a contar.
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-secondary py-2 small mb-2">
                                La ventana de prueba ha terminado: la URL <strong>vuelve a contar</strong>.
                                Puedes reanudarla o cerrar el panel.
                            </div>
                        }
                    }
                    else if (_test is not null)
                    {
                        <div class="alert alert-info py-2 small mb-2">
                            Las solicitudes que lleguen ahora <strong>no cuentan</strong>. Al guardar, esta misma URL
                            queda como definitiva: es la que reseteará los contadores en producción.
                        </div>
                    }
                    else if (HasSavedUrl && _savedTestModeUntil is DateTime pending && pending > DateTime.UtcNow)
                    {
                        <div class="alert alert-warning py-2 small mb-2">
                            Hay una prueba en curso hasta las @Hora(pending): esta vigilancia <strong>no está
                            contando</strong> ni se evalúa.
                            <button type="button" class="btn btn-sm btn-outline-secondary ms-2" @onclick="StartTestAsync" disabled="@_testBusy">Ver la prueba</button>
                        </div>
                    }
                    else if (HasSavedUrl)
                    {
                        <p class="small text-muted mb-2">
                            Esta URL está en producción: cada solicitud confirma la tarea. Para ensayar sin que
                            cuente, pulsa «Probar sin que cuente».
                        </p>
                    }

                    <p class="mb-1 small">
                        @if (_lastHit is DateTime last)
                        {
                            <span class="badge text-bg-success">✔</span>
                            <span class="ms-1">Última solicitud: <strong>@Hora(last)</strong> (@Hace(last))</span>
                        }
                        else if (_test is not null)
                        {
                            <span class="spinner-border spinner-border-sm text-secondary" role="status"></span>
                            <span class="ms-1 text-muted">Esperando la primera solicitud…</span>
                        }
                        else
                        {
                            <span class="text-muted">Todavía no ha llegado ninguna solicitud.</span>
                        }
                    </p>

                    @if (_hits.Count > 0)
                    {
                        <details>
                            <summary class="small">Historial de solicitudes (@_hits.Count)</summary>
                            <div class="table-responsive mt-2" style="max-height:16rem;overflow:auto">
                                <table class="table table-sm small align-middle mb-0">
                                    <thead>
                                        <tr><th>Hora</th><th>Tipo</th><th>Origen</th><th>IP</th><th></th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var h in _hits)
                                        {
                                            <tr>
                                                <td class="text-nowrap">@Hora(h.ReceivedAtUtc)</td>
                                                <td>@Tipo(h.Kind)</td>
                                                <td class="text-nowrap">@h.Source @(h.Method is null ? null : $"({h.Method})")</td>
                                                <td class="font-monospace">@h.RemoteIp</td>
                                                <td>
                                                    @if (h.Counted)
                                                    {
                                                        <span class="badge text-bg-success">cuenta</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge text-bg-secondary">prueba</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </details>
                    }

                    @if (_testError is not null)
                    {
                        <div class="alert alert-danger py-2 small mb-0 mt-2">@_testError</div>
                    }
                </div>
            </div>
        }

        <div class="row g-2 mb-3">
            <div class="col-12"><label class="form-label">Periodicidad</label></div>
            <div class="col-4">
                <select class="form-select" @bind="_scheduleKind">
                    <option value="@ScheduleKind.Interval">Cada…</option>
                    <option value="@ScheduleKind.Cron">Cron</option>
                </select>
            </div>
            @if (_scheduleKind == ScheduleKind.Interval)
            {
                <div class="col-4"><input type="number" min="1" class="form-control" @bind="_intervalValue" /></div>
                <div class="col-4">
                    <select class="form-select" @bind="_intervalUnit">
                        <option value="60">minutos</option>
                        <option value="3600">horas</option>
                        <option value="86400">días</option>
                    </select>
                </div>
            }
            else
            {
                <div class="col-8"><input class="form-control" @bind="_cron" placeholder="0 9 * * 1 (lunes 9:00)" /></div>
            }
        </div>

        <div class="row g-2 mb-3">
            <div class="col-6">
                <label class="form-label">Margen de retraso (min)</label>
                <input type="number" min="0" class="form-control" @bind="_graceMinutes" />
            </div>
            <div class="col-6">
                <label class="form-label">Fallos tolerados</label>
                <input type="number" min="0" class="form-control" @bind="_skip" />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Avisarme por (apilable)</label>
            <div>
                <label class="me-3"><input type="checkbox" @bind="_email" /> Email</label>
                <label class="me-3"><input type="checkbox" @bind="_telegram" /> Telegram</label>
                <label class="me-3"><input type="checkbox" @bind="_push" /> Push</label>
                <label class="me-3"><input type="checkbox" @bind="_sms" /> SMS 💳</label>
                <label class="me-3"><input type="checkbox" @bind="_whatsapp" /> WhatsApp 💳</label>
            </div>
            <small class="text-muted">💳 = consume créditos de tu wallet.</small>
        </div>

        <div class="mb-3">
            <label class="form-label">Integraciones salientes (opcional)</label>
            <input class="form-control mb-1" @bind="_slackUrl" placeholder="URL de webhook de Slack" />
            <input class="form-control mb-1" @bind="_discordUrl" placeholder="URL de webhook de Discord" />
            <input class="form-control mb-1" @bind="_teamsUrl" placeholder="URL de webhook de Microsoft Teams" />
            <input class="form-control" @bind="_webhookUrl" placeholder="URL de webhook genérico (POST JSON)" />
        </div>

        <div class="mb-3">
            <label class="form-label">Severidad</label>
            <select class="form-select" @bind="_severity">
                <option value="@Severity.Low">Baja</option>
                <option value="@Severity.Medium">Media</option>
                <option value="@Severity.High">Alta</option>
                <option value="@Severity.Critical">Crítica</option>
            </select>
        </div>

        @if (_teams.Count > 0)
        {
            <div class="mb-3">
                <label class="form-label">Escalar a equipo (on-call) si no se reconoce</label>
                <div class="input-group">
                    <select class="form-select" @bind="_escalationTeamId">
                        <option value="">— ninguno —</option>
                        @foreach (var t in _teams)
                        {
                            <option value="@t.Id">@t.Name</option>
                        }
                    </select>
                    <span class="input-group-text">tras (min)</span>
                    <input type="number" min="0" class="form-control" style="max-width:110px" @bind="_teamDelayMinutes" />
                </div>
            </div>
        }

        @if (_error is not null)
        {
            <div class="alert alert-danger py-2">@_error</div>
        }

        <div class="d-flex gap-2">
            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_busy">@(_busy ? "Guardando…" : "Guardar")</button>
            <a class="btn btn-outline-secondary" href="">Cancelar</a>
        </div>
    </div>
</div>

@code {
    [Parameter] public string? Id { get; set; }
    private bool IsEdit => !string.IsNullOrEmpty(Id);

    private string _name = string.Empty;
    private string? _description;
    private WatchType _type = WatchType.Manual;
    private ScheduleKind _scheduleKind = ScheduleKind.Interval;
    private int _intervalValue = 1;
    private int _intervalUnit = 86400;
    private string _cron = "0 9 * * *";
    private int _graceMinutes = 30;
    private int _skip;
    private Severity _severity = Severity.Medium;
    private bool _email = true, _telegram, _push, _sms, _whatsapp;
    private string? _slackUrl, _discordUrl, _teamsUrl, _webhookUrl;
    private List<TeamDto> _teams = new();
    private string? _escalationTeamId;
    private int _teamDelayMinutes = 15;
    private string? _error;
    private bool _busy;

    // ---- Banco de pruebas de la URL de ping (F03.03) ----
    private PingTestStateDto? _test;
    private string? _savedPingToken;
    private DateTime? _savedTestModeUntil;
    private List<PingTestHitDto> _hits = new();
    private DateTime? _lastHit;
    private bool _testBusy, _copied;
    private string? _testError;
    private CancellationTokenSource? _pollCts;

    private bool HasSavedUrl => !string.IsNullOrEmpty(_savedPingToken);
    private string? PingUrl => _test?.Url
        ?? (HasSavedUrl ? $"{Api.BaseAddress?.ToString().TrimEnd('/')}/p/{_savedPingToken}" : null);

    protected override async Task OnInitializedAsync()
    {
        var teamsResult = await Api.GetTeamsAsync();
        if (teamsResult.Ok && teamsResult.Value is not null) _teams = teamsResult.Value;

        _pollCts = new CancellationTokenSource();
        _ = PollAsync(_pollCts.Token);

        if (!IsEdit) return;
        var result = await Api.GetWatchAsync(Id!);
        if (!result.Ok || result.Value is null) { _error = result.Error; return; }
        var w = result.Value;
        _name = w.Name; _description = w.Description; _type = w.Type;
        _savedPingToken = w.PingToken;
        _savedTestModeUntil = w.TestModeUntilUtc;
        _scheduleKind = w.Schedule.Kind; _cron = w.Schedule.CronExpression ?? _cron;
        if (w.Schedule.IntervalSeconds is { } secs) { _intervalUnit = secs % 86400 == 0 ? 86400 : secs % 3600 == 0 ? 3600 : 60; _intervalValue = Math.Max(1, secs / _intervalUnit); }
        _graceMinutes = w.Tolerance.GraceSeconds / 60; _skip = w.Tolerance.SkipTolerance; _severity = w.Severity;
        _email = Has(w, ChannelType.Email); _telegram = Has(w, ChannelType.Telegram); _push = Has(w, ChannelType.Push);
        _sms = Has(w, ChannelType.Sms); _whatsapp = Has(w, ChannelType.WhatsApp);
        _slackUrl = Dest(w, ChannelType.Slack); _discordUrl = Dest(w, ChannelType.Discord);
        _teamsUrl = Dest(w, ChannelType.MicrosoftTeams); _webhookUrl = Dest(w, ChannelType.Webhook);
        _escalationTeamId = w.EscalationTeamId;
        _teamDelayMinutes = w.TeamEscalationDelaySeconds / 60;

        if (HasSavedUrl) await RefreshHistoryAsync();
    }

    private static bool Has(WatchDto w, ChannelType t) => w.ChannelBindings.Any(b => b.ChannelType == t && b.Enabled);
    private static string? Dest(WatchDto w, ChannelType t) => w.ChannelBindings.FirstOrDefault(b => b.ChannelType == t)?.DestinationOverride;

    // ---- Banco de pruebas (F03.03) ----

    /// <summary>Al elegir «Ping» se reserva ya la URL definitiva para poder ensayarla durante el alta.</summary>
    private async Task OnTypeChangedAsync()
    {
        if (_type == WatchType.Ping && _test is null && !HasSavedUrl) await StartTestAsync();
    }

    private async Task StartTestAsync()
    {
        _testBusy = true; _testError = null;
        var r = await Api.StartPingTestAsync(new StartPingTestRequest(IsEdit ? Id : null));
        _testBusy = false;
        if (r.Ok && r.Value is not null) Apply(r.Value);
        else _testError = r.Error;
    }

    private async Task StopTestAsync()
    {
        _testBusy = true;
        var probeId = _test?.ProbeId;
        _test = null;
        _savedTestModeUntil = null;
        if (probeId is not null) await Api.StopPingTestAsync(probeId);
        _testBusy = false;
        if (HasSavedUrl) await RefreshHistoryAsync(); else { _hits.Clear(); _lastHit = null; }
    }

    private void Apply(PingTestStateDto state)
    {
        _test = state;
        _hits = state.Hits;
        _lastHit = state.Hits.Count > 0 ? state.Hits[0].ReceivedAtUtc : state.LastHitAtUtc;
        _savedTestModeUntil = state.TestModeUntilUtc;
    }

    /// <summary>Sin prueba en curso el histórico son los check-ins reales de la vigilancia.</summary>
    private async Task RefreshHistoryAsync()
    {
        var r = await Api.GetCheckInsAsync(Id!);
        if (!r.Ok || r.Value is null) return;
        _hits = r.Value.Select(c => new PingTestHitDto(c.ReceivedAtUtc, c.Kind, c.Source, true, null, null, null, null)).ToList();
        _lastHit = _hits.Count > 0 ? _hits[0].ReceivedAtUtc : null;
    }

    /// <summary>Refresco en vivo: rápido mientras se ensaya, pausado cuando solo se mira el histórico.</summary>
    private async Task PollAsync(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(_test is not null ? 3 : 15), ct);
                if (_type != WatchType.Ping) continue;

                if (_test is not null)
                {
                    var r = await Api.GetPingTestAsync(_test.ProbeId);
                    if (r.Ok && r.Value is not null) Apply(r.Value);
                    else _test = null;                      // caducó: el TTL ya lo ha limpiado
                }
                else if (HasSavedUrl)
                {
                    await RefreshHistoryAsync();
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { /* navegación */ }
    }

    private async Task CopyAsync(string url)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
            _copied = true;
            StateHasChanged();
            await Task.Delay(TimeSpan.FromSeconds(2));
            _copied = false;
        }
        catch { _testError = "No se ha podido copiar; selecciona la URL y cópiala a mano."; }
    }

    private static string Hora(DateTime utc) => utc.ToLocalTime().ToString("HH:mm:ss");

    private static string Hace(DateTime utc)
    {
        var seconds = (DateTime.UtcNow - utc).TotalSeconds;
        if (seconds < 60) return $"hace {Math.Max(0, (int)seconds)} s";
        if (seconds < 3600) return $"hace {(int)(seconds / 60)} min";
        return $"hace {(int)(seconds / 3600)} h";
    }

    private static string Tipo(string kind) => kind switch
    {
        "Start" => "▶ inicio",
        "Fail" => "✖ fallo",
        _ => "✔ hecho",
    };

    public async ValueTask DisposeAsync()
    {
        _pollCts?.Cancel();
        _pollCts?.Dispose();

        // Salir sin guardar cierra la prueba: el dry-run deja de suspender la vigilancia y el borrador
        // se borra (el TTL de Mongo es solo la red de seguridad si el navegador se cierra de golpe).
        if (_test is not null)
        {
            try { await Api.StopPingTestAsync(_test.ProbeId); } catch { /* el TTL lo limpiará */ }
        }
    }

    private async Task SaveAsync()
    {
        _busy = true; _error = null;
        var schedule = new Schedule
        {
            Kind = _scheduleKind,
            IntervalSeconds = _scheduleKind == ScheduleKind.Interval ? _intervalValue * _intervalUnit : null,
            CronExpression = _scheduleKind == ScheduleKind.Cron ? _cron : null,
            TimeZoneId = TimeZoneInfo.Local.Id,
        };
        var tolerance = new Tolerance { GraceSeconds = _graceMinutes * 60, SkipTolerance = _skip };
        var bindings = BuildBindings();
        // La vigilancia adopta el token ensayado: la URL probada es exactamente la de producción (F03.03).
        var req = new WatchRequest(_name, _description, _type, schedule, tolerance, bindings, _severity, null, null,
            string.IsNullOrEmpty(_escalationTeamId) ? null : _escalationTeamId, _teamDelayMinutes * 60,
            _type == WatchType.Ping ? _test?.ProbeId : null);

        var result = IsEdit ? await Api.UpdateWatchAsync(Id!, req) : await Api.CreateWatchAsync(req);
        _busy = false;
        if (!result.Ok) { _error = result.Error; return; }

        _test = null;   // guardado: la prueba termina en servidor, no hay que cerrarla al navegar
        Nav.NavigateTo("/");
    }

    private List<ChannelBinding> BuildBindings()
    {
        var list = new List<ChannelBinding>();
        void Add(bool on, ChannelType t) { if (on) list.Add(new ChannelBinding { ChannelType = t, Enabled = true, Order = list.Count }); }
        Add(_email, ChannelType.Email);
        Add(_telegram, ChannelType.Telegram);
        Add(_push, ChannelType.Push);
        Add(_sms, ChannelType.Sms);
        Add(_whatsapp, ChannelType.WhatsApp);

        void AddUrl(string? url, ChannelType t)
        {
            if (!string.IsNullOrWhiteSpace(url))
                list.Add(new ChannelBinding { ChannelType = t, Enabled = true, Order = list.Count, DestinationOverride = url!.Trim() });
        }
        AddUrl(_slackUrl, ChannelType.Slack);
        AddUrl(_discordUrl, ChannelType.Discord);
        AddUrl(_teamsUrl, ChannelType.MicrosoftTeams);
        AddUrl(_webhookUrl, ChannelType.Webhook);
        return list;
    }
}
